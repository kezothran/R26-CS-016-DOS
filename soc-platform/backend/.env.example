# Postgres connection string (Supabase session pooler, port 5432)
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Long random string used to sign JWTs. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Minutes before an issued JWT expires
JWT_EXPIRE_MINUTES=480

# Bootstrap admin account created by scripts/seed_admin.py (forced to change password on first login)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me

# Detection engine
CAPTURE_WINDOW_SECS=5
