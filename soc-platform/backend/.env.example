# Postgres connection string (Supabase session pooler, port 5432)
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Long random string used to sign JWTs. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480

# Bootstrap admin account created by scripts/seed_admin.py (forced to change password on first login)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me

# Detection engine
CAPTURE_WINDOW_SECS=5

# Public dashboard URL, used for "Open incident" buttons in alert emails
DASHBOARD_URL=http://localhost:3000

# Geo-IP for the attack map (free MaxMind GeoLite2-City.mmdb)
GEOIP_DB_PATH=

# Email alerts + summary email (Gmail: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=a@example.com,b@example.com
SUMMARY_SCHEDULE=off
SUMMARY_HOUR=8

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp via Meta Cloud API (numbers: digits only, e.g. 94771234567)
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_TO=
META_WA_API_VERSION=v25.0
META_WA_WABA_ID=
META_WA_TEMPLATE_PREFIX=

# Free WhatsApp alternative (CallMeBot): +94771234567:apikey
CALLMEBOT_RECIPIENTS=

# Slack
SLACK_WEBHOOK_URL=

# Jira Cloud tickets
JIRA_BASE_URL=https://<site>.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
